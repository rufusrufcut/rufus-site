---
// Concept label: a concept's registry shape followed by its name (a place, a club).
// Design system rule: wherever a concept from src/data/icon-registry.json is shown as a label
// (not inside running text), use this component (or PlaceLabel for places). See DESIGN-SYSTEM.md.
// The icon takes the highlight colour (--signal) unless the surrounding element sets
// --concept-label-colour (the Jiu-Jitsu panel sets it to the month's belt colour).
// Usage: <ConceptLabel concept="club" id="mnbjj" /> shows the registry name.
//        <ConceptLabel concept="place" id="melbourne">Melbourne, Australia</ConceptLabel> shows your own wording.
import ConceptIcon from './ConceptIcon.astro';
import registry from '../data/icon-registry.json';

interface Props {
  concept: 'place' | 'club';
  id: string;
}
const { concept, id } = Astro.props;
const item = registry.dimensions[concept]?.items.find((i) => i.id === id);
const name = item ? item.name : id; // ConceptIcon stops the build if the id is unknown
---
<span class="concept-label"><ConceptIcon concept={concept} id={id} /><span class="name"><slot>{name}</slot></span></span>

<style>
  /* Icon then name, top-aligned so the icon sits on the first line when a long name wraps.
     The icon is decorative (aria-hidden); the name carries the meaning for screen readers. */
  .concept-label {
    --concept-icon-colour: var(--concept-label-colour, var(--signal));
    display: inline-flex;
    align-items: flex-start;
    gap: 0.4em;
  }
  .concept-label :global(.concept-icon) {
    margin-top: -0.1em;
  }
  /* The name sets the label's baseline, so the label lines up with text beside it. */
  .name {
    align-self: baseline;
  }
</style>
