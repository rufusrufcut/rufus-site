---
// Concept icon: one shape per concept, site-wide.
// Looks up a concept (for example the place "melbourne") in src/data/icon-registry.json
// and draws the unit shape assigned to it. To reassign a shape, change the concept's
// "shape" number in the registry: every page that shows the concept changes with it,
// including the Jiu-Jitsu visualisation, which reads the same file.
// Every icon sits in a circle container, as in the Jiu-Jitsu visualisation.
// Usage: <ConceptIcon concept="club" id="mnbjj" /> for a club; concept="belt" draws a circle in the belt's colour.
// Places and clubs each own different shape numbers, so every shape draws at full size.
// Usage: <ConceptIcon concept="place" id="melbourne" />
// The icon is decorative (aria-hidden), so always show the concept's name next to it.
import registry from '../data/icon-registry.json';

interface Props {
  concept: 'place' | 'club' | 'belt';
  id: string;
}
const { concept, id } = Astro.props;
const item = registry.dimensions[concept]?.items.find((i) => i.id === id);
// A belt has no shape: it is shown as a circle filled with its colour.
const isBelt = concept === 'belt';
// Fail the build on a typo rather than ship a page with a missing icon.
if (!item || (isBelt ? !item.colour : item.shape == null)) {
  throw new Error(`ConceptIcon: nothing assigned to ${concept} "${id}" in icon-registry.json`);
}
const shape = isBelt ? '' : registry.shapes[String(item.shape)];
---
<svg
  class="concept-icon"
  viewBox="0 0 150 150"
  aria-hidden="true"
  focusable="false"
  data-concept={concept}
  data-id={id}
>
  {isBelt
    ? <circle class="swatch" cx="75" cy="75" r="73" fill={item.colour} />
    : <><g set:html={shape} /><circle class="container" cx="75" cy="75" r="73" /></>}
</svg>

<style>
  /* Sized to the surrounding text. Drawn in ink unless the page sets --concept-icon-colour
     (the CV sets it to the highlight colour, --signal). Same geometry as the Jiu-Jitsu
     visualisation: the shape inside a circle container (r 73 in a 150 box), so every
     concept keeps the same scale and only its form changes. The circle's line stays
     1px at any size (non-scaling stroke), so it doesn't vanish when the icon is small. */
  .concept-icon {
    width: 1.5em;
    height: 1.5em;
    flex: none;
    fill: var(--concept-icon-colour, var(--ink));
  }
  .container {
    fill: none;
    stroke: var(--concept-icon-colour, var(--ink));
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
</style>
